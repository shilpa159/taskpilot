# --- Database ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://taskpilot:taskpilot@localhost:3306/taskpilot

# --- Auth ---
# Generate a strong random value, e.g. `openssl rand -hex 32`
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI breakdown feature (Anthropic API) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# For local dev with the provided frontend, keep the defaults below.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
